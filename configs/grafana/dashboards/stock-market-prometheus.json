{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Availability (up)",
      "datasource": { "type": "prometheus", "uid": "PROM_DS_UID" },
      "targets": [
        { "expr": "avg(up{job=\"stock-market\"})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "mappings": [] } },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 }
    },
    {
      "type": "timeseries",
      "title": "RPS (total)",
      "datasource": { "type": "prometheus", "uid": "PROM_DS_UID" },
      "targets": [
        { "expr": "sum(rate(stock_market_http_requests_total[1m]))", "legendFormat": "rps", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 5 }
    },
    {
      "type": "timeseries",
      "title": "Success vs Errors (RPS)",
      "datasource": { "type": "prometheus", "uid": "PROM_DS_UID" },
      "targets": [
        {
          "expr": "sum(rate(stock_market_http_requests_total{status=~\"2..\"}[1m]))",
          "legendFormat": "success (2xx)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(stock_market_http_requests_total{status=~\"4..|5..\"}[1m]))",
          "legendFormat": "errors (4xx+5xx)",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 5 }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 / p99 (all HTTP)",
      "datasource": { "type": "prometheus", "uid": "PROM_DS_UID" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stock_market_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(stock_market_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 }
    },
    {
      "type": "timeseries",
      "title": "RPS by Path (all)",
      "datasource": { "type": "prometheus", "uid": "PROM_DS_UID" },
      "targets": [
        {
          "expr": "sum(rate(stock_market_http_requests_total[1m])) by (path, method)",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 }
    },
    {
      "type": "timeseries",
      "title": "Trades: success vs errors",
      "datasource": { "type": "prometheus", "uid": "PROM_DS_UID" },
      "targets": [
        {
          "expr": "sum(rate(stock_market_trades_total[1m])) by (type)",
          "legendFormat": "success {{type}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(stock_market_trade_errors_total[1m])) by (reason)",
          "legendFormat": "error {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["stock-market", "prometheus", "stress"],
  "time": { "from": "now-5m", "to": "now" },
  "timezone": "",
  "title": "Stock Market - Stress and Reliability",
  "version": 2
}