      "targets": [
        {
          "expr": "sum by (path) (count_over_time(({app=\"stock-market\", container=~\".*app.*\"} | json | __error__=\"\" | msg=\"http_request\")[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 7 }
