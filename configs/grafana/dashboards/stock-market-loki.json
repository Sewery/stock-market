  "panels": [
    {
      "type": "timeseries",
      "title": "Log Volume (per minute)",
      "datasource": { "type": "loki", "name": "Loki", "uid": "stock-market-loki" },
      "targets": [
        {
          "expr": "sum by (container) (count_over_time({app=\"stock-market\", container=~\".*app.*\"}[1m]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests (per minute)",
      "datasource": { "type": "loki", "name": "Loki", "uid": "stock-market-loki" },
      "targets": [
        {
          "expr": "sum by (container) (count_over_time(({app=\"stock-market\", container=~\".*app.*\"} | json | __error__=\"\" | msg=\"http_request\")[1m]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Slow Requests (latency_ms > 50)",
      "datasource": { "type": "loki", "name": "Loki", "uid": "stock-market-loki" },
      "targets": [
        {
          "expr": "sum by (container) (rate(({app=\"stock-market\", container=~\".*app.*\"} | json | __error__=\"\" | msg=\"http_request\" | latency_ms > 50)[1m]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 }
    },
    {
        "type": "stat",
        "title": "Slow Requests (total in range, > 50ms)",
        "datasource": { "type": "loki", "name": "Loki", "uid": "stock-market-loki" },
        "targets": [
          {
            "expr": "sum(count_over_time(({app=\"stock-market\", container=~\".*app.*\"} | json | __error__=\"\" | msg=\"http_request\" | latency_ms > 50)[$__range]))",
            "legendFormat": "total",
            "refId": "A"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } },
        "gridPos": { "x": 0, "y": 13, "w": 12, "h": 5 }
    },
